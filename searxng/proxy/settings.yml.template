# SearXNG settings for the PROXY instance.
# Do not edit by hand: the web app renders this template into the searxng-proxy container whenever the
# proxy settings are saved in the UI (Settings -> Proxy). It fills in two placeholders below:
#   instance_name  a fingerprint of the proxy settings, used to check the new settings are live
#   proxies        the proxy from Settings, or a dead address when the proxy is turned off
use_default_settings: true

general:
  instance_name: __INSTANCE_NAME__

server:
  secret_key: "overridden-by-SEARXNG_SECRET"
  limiter: false
  public_instance: false
  image_proxy: false

search:
  safe_search: 0
  formats:
    - html
    - json

outgoing:
  request_timeout: 10.0   # proxies add latency
  max_request_timeout: 20.0
  proxies:
    all://:
      - __PROXY_URL__

engines:
  - name: brave
    disabled: false
  - name: bing
    disabled: false
  - name: yahoo
    disabled: false
  - name: mwmbl
    disabled: false
