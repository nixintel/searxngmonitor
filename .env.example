# Copy to .env and fill in. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---- Optional extras: any of mail,proxy,flower (comma separated).
#      "mail" runs Mailpit, a test inbox at http://localhost:8025 that catches all alert emails.
COMPOSE_PROFILES=mail

# ---- Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when served on a non-localhost origin, e.g. https://monitor.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
TIME_ZONE=UTC
WEB_PORT=8000
GUNICORN_WORKERS=3
# Used to build links in notification emails
APP_BASE_URL=http://localhost:8000

# ---- Login (created/updated at web startup)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=

# ---- Database
POSTGRES_DB=searxngmonitor
POSTGRES_USER=searxngmonitor
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://searxngmonitor:change-me@postgres:5432/searxngmonitor

# ---- Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_CONCURRENCY=4

# ---- SearXNG
SEARXNG_SECRET=change-me
SEARXNG_URL=http://searxng:8080
SEARXNG_TIMEOUT=20
DEFAULT_ENGINES=brave,bing,yahoo,mwmbl
MIN_INTERVAL_MINUTES=5
# Optional, e.g. mailto:you@example.com - enables Wikipedia/Wikidata/OSM engines
SEARXNG_CONTACT_URL=

# ---- Proxy (requires "proxy" in COMPOSE_PROFILES)
SEARXNG_PROXY_ENABLED=false
SEARXNG_PROXY_URL=http://searxng-proxy:8080
PROXY_URL=

# ---- Email (SMTP). For local testing add "mail" to COMPOSE_PROFILES and use
#      EMAIL_HOST=mailpit EMAIL_PORT=1025, then open http://localhost:8025
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=searxng-monitor@localhost
# Fallback recipient when a search has no address of its own
NOTIFY_EMAIL_TO=

# ---- Slack (optional). Incoming-webhook URL used when a search has none of its own;
#      can also be set in the UI under Settings. See README "Slack alerts".
SLACK_WEBHOOK_URL=
